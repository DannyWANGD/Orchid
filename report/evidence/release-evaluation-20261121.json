      {
        "keywords": [
          "清霜"
        ],
        "prompt_id": "M016",
        "raw": "清浄妙難測，寒碧照秋霜。夜深猶獨看，霜重月黄昏。",
        "rhymed": "白雪滿山谷，清霜覆井梧。歲窮人事變，身老道心孤。",
        "sampling_seed": 11
      },
      {
        "keywords": [
          "霜",
          "孤舟"
        ],
        "prompt_id": "M017",
        "raw": "一望長江闊，千尋古戍閑。煙波猶未定，不得上孤山。",
        "rhymed": "霜葉滿空落，悲心無處尋。孤舟寒夜水，獨自照秋林。",
        "sampling_seed": 11
      },
      {
        "keywords": [
          "清風",
          "桂花"
        ],
        "prompt_id": "M033",
        "raw": "清光分玉露，和氣入薰風。一是東皇力，人生樂事同。",
        "rhymed": "桂花香滿山，半在清風前。不同凡草木，移取入幽泉。",
        "sampling_seed": 11
      },
      {
        "keywords": [
          "孤舟",
          "春雨",
          "煙波"
        ],
        "prompt_id": "M034",
        "raw": "春潮平地脈，曉氣入雲深。獨立蒼茫裏，無人識此心。",
        "rhymed": "煙波春渺渺，寂寂孤舟閑。春雨夜來雨，空江寒葦山。",
        "sampling_seed": 11
      },
      {
        "keywords": [
          "南山",
          "小雨",
          "月影"
